# À utiliser APRÈS obtention du certificat Let's Encrypt.
#   cp docker/nginx-proxy/conf.d/panel.ssl.conf.example docker/nginx-proxy/conf.d/panel.conf
#   docker compose -f docker-compose.proxy.yml restart reverse-proxy

upstream pixelcraft_app {
    server pixelcraft-nginx:80;
    keepalive 16;
}

server {
    listen 80;
    server_name panel.pixelcraft-studios.fr;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name panel.pixelcraft-studios.fr;

    ssl_certificate     /etc/letsencrypt/live/panel.pixelcraft-studios.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/panel.pixelcraft-studios.fr/privkey.pem;

    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://pixelcraft_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffer_size 128k;
        proxy_buffers 8 256k;
        proxy_busy_buffers_size 256k;
        proxy_read_timeout 120s;
    }

    location /app {
        proxy_pass http://pixelcraft_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}

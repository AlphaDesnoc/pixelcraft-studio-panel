# Config HTTP — à utiliser AVANT d'obtenir le certificat SSL.
#   cp docker/nginx-proxy/conf.d/panel.http.conf.example docker/nginx-proxy/conf.d/panel.conf
#   (remplace le domaine) puis restart reverse-proxy

upstream pixelcraft_app {
    server pixelcraft-nginx:80;
    keepalive 16;
}

server {
    listen 80;
    server_name panel.tondomaine.fr;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://pixelcraft_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    location /app {
        proxy_pass http://pixelcraft_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}

# Copier ce fichier en .env sur le serveur avant le déploiement Portainer
# cp .env.docker.example .env

APP_NAME="PixelCraft Studio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://panel.tondomaine.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# Port exposé par le conteneur nginx (80 en prod, 8080 si conflit)
APP_PORT=80

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Base MariaDB (service "db" dans docker-compose)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pixelcraft
DB_USERNAME=pixelcraft
DB_PASSWORD=change_me_db_password
DB_ROOT_PASSWORD=change_me_root_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=reverb

# Clés Reverb — générer avec: php artisan reverb:install (en local)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Ce que le navigateur utilise (domaine public)
REVERB_HOST=panel.tondomaine.fr
REVERB_PORT=443
REVERB_SCHEME=https

# Processus Reverb interne (ne pas changer sauf besoin)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Injectées dans le JS au BUILD Docker (rebuild si modifiées)
VITE_APP_NAME="${APP_NAME}"

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@tondomaine.fr"
MAIL_FROM_NAME="${APP_NAME}"

PIXELCRAFT_EMAIL_DOMAIN=pixelcraftstudio.fr
